# Copy this file to .env and fill it in. .env is ignored by git.

# The Client ID of your own Twitch application (https://dev.twitch.tv/console/apps).
# It is public: it identifies the app, and no client secret is needed.
VITE_TWITCH_CLIENT_ID=

# Set to "debug" to print the extension's debug log. Leave empty for normal builds.
VITE_LOGGER_LEVEL=
